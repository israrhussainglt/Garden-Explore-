<div class="modal fade full-screen" id="search-overlay" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header container">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="gbb-clear"></i>
                </button>
            </div>
            <div class="modal-body container">
                <div class="search-component" data-component="search" data-endpoint="/content/experience-fragments/gbb-2021/sg/en/site/header/master/jcr:content/root/search_panel.model.page.p{PAGE}.json?q={QUERY}&amp;limit=10&amp;qid=548538397">

                    <div class="search-menu">
                        <div class="search-bar">
                            <div class="search-bar-label">
                                <h4>How can we help you?</h4>
                            </div>

                            <div class="search-bar-input" data-get="keywords" data-endpoint="/content/experience-fragments/gbb-2021/sg/en/site/header/master/jcr:content/root/search_panel.suggestion.json?q={q}">

                                <vue-autosuggest v-model="query" :suggestions="filteredKeywords" :input-props="{id:'autosuggest__input', placeholder:'Search attractions, itineraries and more'}" :get-suggestion-value="getSuggestionValue" @keyup.enter.stop.prevent="currentFilters = [], filterResults()" @focus="onFocus" @input="onInputChange" @selected="onSelected">
                                    <template slot="before-input">
                                        <div class="search-button" @click="currentFilters = [], filterResults()">
                                            <img src="/etc.clientlibs/gbb-2021/clientlibs/clientlib-dependencies/resources/images/icons-images/search-dark.png" alt="seach icon"/>
                                        </div>
                                    </template>
                                    <div slot-scope="{suggestion}" class="auto-suggestion">
                                        <div class="auto-suggestion__label">{{ suggestion.item }}</div>
                                    </div>
                                </vue-autosuggest>
                            </div>
                        </div>
                        <div class="search-options">
                            <div class="search-options-label">
                                
                                <h6>Popular searches</h6>
                            </div>

                                <ul class="options">
                                <li @click="query = 'Floral Fantasy', currentFilters = [], filterResults()" class="option">
                                    <span>Floral Fantasy</span>
                                </li>
                            
                                <li @click="query = 'Supertrees', currentFilters = [], filterResults()" class="option">
                                    <span>Supertrees</span>
                                </li>
                            
                                <li @click="query = 'Flower Dome', currentFilters = [], filterResults()" class="option">
                                    <span>Flower Dome</span>
                                </li>
                            
                                <li @click="query = 'OCBC Skyway', currentFilters = [], filterResults()" class="option">
                                    <span>OCBC Skyway</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div v-if="noOfResults > 0 && isSubmitted && !searchResultsError" class="search-content-container" :class="{ oneColumn: searchFilters.length < 1 }">
                        <div v-if="submittedQuery" class="results-found">
                            <span>{{ noOfResults }} results found for "{{ submittedQuery }}"</span>
                        </div>

                        <div class="search-content">
                            <div v-if="isMobile && searchFilters.length >= 1" class="mobile-filters">
                                <div class="filter-by">
                                    <span class="label">Filter by</span>
                                    <span v-if="currentFilters.length >= 1" class="count">({{ currentFilters.length }})</span>
                                </div>
                                <div v-if="!isOpenedFilter" class="toggle-button" @click="isOpenedFilter = !isOpenedFilter">
                                    <img src="/etc.clientlibs/gbb-2021/clientlibs/clientlib-dependencies/resources/images/icons-images/icons-small-plus.svg" alt="+"/>
                                </div>
                                <div v-if="isOpenedFilter" class="toggle-button" @click="isOpenedFilter = !isOpenedFilter">
                                    <span>Close</span>
                                </div>
                            </div>

                            <div v-if="searchFilters.length >= 1 && !isMobile || isOpenedFilter && isMobile" class="search-filters">
                                <div v-for="(filter, index) in searchFilters" class="search-filter" :class="{ disabled: filter.count < 1 }">
                                    <input type="checkbox" :id="filter.categoryID" :value="filter.categoryID" :disabled="filter.count < 1" v-model="currentFilters" @change="filterResults()"/>
                                    <label :for="filter.categoryID">
                                        <span>{{ filter.categoryName }}</span>
                                        <span v-if="filter.count > 0">({{ filter.count }})</span>
                                    </label>
                                    <div class="filter-checkbox"></div>
                                </div>
                            </div>

                            <div v-if="searchResults.length >= 1 && isSubmitted" class="search-results">
                                <div class="results-showing">
                                    <span>Showing {{ searchResults.length }} out of {{ noOfResults }}</span>
                                </div>

                                <div v-for="result in searchResults" class="search-result">
                                    <div class="search-result-image">
                                        <img class="img-fluid" :src="result.image" :alt="result.name"/>
                                        <div v-if="result.category.label" class="category" :style="{ background: result.category.backgroundColor }">
                                            <span>{{ result.category.label }}</span>
                                        </div>
